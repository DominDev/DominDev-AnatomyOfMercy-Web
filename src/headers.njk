# Naglowki odpowiedzi dla Cloudflare Workers ze Static Assets.
# Plik jest generowany, poniewaz skrot skryptu w polityce bezpieczenstwa musi
# pochodzic z tego samego zrodla co skrypt wstawiony do strony.
#
# img-src dopuszcza data: wylacznie dlatego, ze ornament naroznikow ramy jest
# osadzonym w stylach obrazem SVG. Bez tego rama traci gwiazdki, co pierwsza
# wersja polityki faktycznie zrobila.
#
# Odkad fonty leza na naszym serwerze, polityka nie wpuszcza zadnego obcego
# serwera. Wczesniej byly tu wyjatki na fonts.googleapis.com i fonts.gstatic.com.
#
# media-src i autoplay=(self) wpuszczaja muzyke w tle z wlasnego serwera
# (music.js). Bez autoplay=(self) przegladarka nie zagra jej nawet po
# przejsciu na kolejna podstrone, choc odwiedzajacy juz klikal na stronie.
{%- if not site.isProduction %}
#
# Wydanie podgladowe. robots.txt juz prosi roboty, zeby nie zagladaly, ale ten
# plik dziala wylacznie wtedy, gdy robot go przeczyta. Naglowek nizej dziala
# takze wtedy, gdy adres podgladu trafi do wyszukiwarki z linku, bo noindex nie
# wymaga wczesniejszej zgody na czytanie robots.txt.
#
# Robotom budujacym kafelek linku to nie przeszkadza. One niczego nie indeksuja,
# tylko pobieraja strone po Open Graph, a naglowek dotyczy indeksowania.
{%- endif %}
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' '{{ csp.scriptHash }}'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
{%- if not site.isProduction %}
  X-Robots-Tag: noindex, nofollow
{%- endif %}

# Interaktywny dylemat. Strona ukryta: nigdy do wyszukiwarek, takze w
# produkcji. Polityka bezpieczenstwa jest odlaczona i zastapiona wlasna, bo
# strona ma wlasne skrypty bez osadzonego wejscia; dwie polityki naraz
# dzialalyby jak czesc wspolna i blokowalyby wiecej, niz trzeba.
# Permissions-Policy dopuszcza odtwarzanie z wlasnego zrodla, uruchamiane
# wylacznie kliknieciem gracza.
/pl/dylemat/*
  ! Content-Security-Policy
  ! Permissions-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
