{% set t = i18n[lang] %}
<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#090807">
    <meta name="color-scheme" content="dark">
    <meta name="description" content="{{ t.meta.description }}">
    <meta property="og:title" content="{{ t.meta.title }}">
    <meta property="og:description" content="{{ t.meta.description }}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="{{ locale }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:url" content="{{ site.url }}{{ canonicalPath }}">
    <meta property="og:image" content="{{ site.url }}/assets/images/social/og-1200x630.jpg">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ t.meta.imageAlt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ t.meta.title }}">
    <meta name="twitter:description" content="{{ t.meta.description }}">
    <meta name="twitter:image" content="{{ site.url }}/assets/images/social/og-1200x630.jpg">
    <meta name="twitter:image:alt" content="{{ t.meta.imageAlt }}">
    <link rel="canonical" href="{{ site.url }}{{ canonicalPath }}">
    <link rel="alternate" hreflang="en" href="{{ site.url }}/">
    <link rel="alternate" hreflang="pl" href="{{ site.url }}/pl/">
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
    {# Skrypt siedzi w osobnym pliku, poniewaz ten sam plik jest zrodlem skrotu
       w polityce bezpieczenstwa tresci. Trzymanie go w dwoch miejscach
       skonczyloby sie tym, ze po zmianie jednego z nich przegladarka po cichu
       przestalaby wykonywac wejscie. #}
    <script>{% include "partials/intro-bootstrap.js" %}</script>
    <link rel="stylesheet" href="/assets/css/main.css">
    <script src="/assets/js/main.js" defer></script>
    <title>{{ t.meta.title }}</title>
  </head>
  <body class="page">
    {% include "partials/preloader.njk" %}
    {% include "partials/frame.njk" %}
    <a class="skip-link" href="#main-content">{{ t.skip }}</a>
    {% include "partials/header.njk" %}
    <main id="main-content" tabindex="-1">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <button class="to-top" type="button" data-to-top aria-label="{{ t.backToTop }}" title="{{ t.backToTop }}">
      <svg viewBox="0 0 24 28" aria-hidden="true" focusable="false">
        <path d="M12 3l4 5.6-4 5.6-4-5.6z M12 21.4l1.5 2.2-1.5 2.2-1.5-2.2z"/>
        <path d="M12 11v13.4"/>
      </svg>
    </button>
  </body>
</html>
