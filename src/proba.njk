---
permalink: /proba/
eleventyExcludeFromCollections: true
---
{#- Interaktywna proba dylematu (Faza 0, ryzyko R-020). Strona celowo ukryta:
    poza kolekcjami, wiec nie trafia do mapy strony ani nawigacji, z noindex w
    znaczniku i w naglowku z _headers. Link rozsylamy recznie.

    Samodzielna jak strona 404: bez naglowka, stopki i sekwencji wejscia, zeby
    nic nie odciagalo od kart. Tresc kart siedzi w src/_data/proba.js; ponizszy
    JSON nie jest wykonywany, wiec polityka bezpieczenstwa go nie dotyczy. -#}
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#090807">
    <meta name="color-scheme" content="dark">
    <meta name="referrer" content="no-referrer">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="/assets/css/main.css">
    <script src="/assets/js/proba.js" defer></script>
    <title>Próba dylematu | Anatomy of Mercy</title>
  </head>
  <body class="proba">
    <main class="proba__stage" id="proba" aria-live="polite">
      <noscript>
        <p class="proba__noscript">Ta próba wymaga włączonego JavaScriptu.</p>
      </noscript>
    </main>
    <div class="proba__bar">
      <span class="proba__brand">Anatomy of Mercy</span>
      <span class="proba__progress" data-progress aria-hidden="true"></span>
      {%- if proba.audio %}
      <button class="proba__sound" type="button" data-sound aria-pressed="false">Dźwięk: wyłączony</button>
      <audio data-audio src="{{ proba.audio }}" loop preload="none"></audio>
      {%- endif %}
    </div>
    <script type="application/json" id="proba-data">{{ proba | dump | safe }}</script>
  </body>
</html>
