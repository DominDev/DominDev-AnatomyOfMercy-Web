{#- Interaktywny dylemat "Swiatlo pod popiolem" (Faza 0, ryzyko R-020). Strona
    celowo ukryta: poza kolekcjami, wiec nie trafia do mapy strony ani
    nawigacji, z noindex w znaczniku i w naglowku z _headers. Link rozsylamy
    recznie.

    Samodzielna jak strona 404: bez naglowka, stopki i sekwencji wejscia
    strony glownej, zeby nic nie odciagalo od opowiesci. Tresc siedzi w
    src/_data/dylemat.js; ponizszy JSON nie jest wykonywany, wiec polityka
    bezpieczenstwa go nie dotyczy. -#}
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#090807">
    <meta name="color-scheme" content="dark">
    <meta name="referrer" content="no-referrer">
    <meta name="description" content="Interaktywny dylemat ze świata Anatomy of Mercy. Every cure leaves a scar.">
    <meta property="og:title" content="Światło pod popiołem | Anatomy of Mercy">
    <meta property="og:description" content="Dziewczynka, cztery drogi leczenia i cena, którą ktoś musi zapłacić. Co zrobisz?">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:image" content="{{ site.url }}/assets/images/social/og-1200x630.jpg">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preload" as="image" href="{{ dylemat.opening.image }}">
    <link rel="stylesheet" href="/assets/css/main.css">
    <script src="/assets/js/dylemat.js" defer></script>
    <title>Światło pod popiołem | Anatomy of Mercy</title>
  </head>
  <body class="dylemat">
    <canvas class="dylemat__ash" data-ash aria-hidden="true"></canvas>
    <main class="dylemat__stage" id="dylemat" aria-live="polite">
      <noscript>
        <p class="dylemat__noscript">Ta opowieść wymaga włączonego JavaScriptu.</p>
      </noscript>
    </main>
    <div class="dylemat__bar">
      <span class="dylemat__brand">Anatomy of Mercy</span>
      <span class="dylemat__chapter" data-chapter aria-hidden="true"></span>
      {%- if dylemat.audio.ambient %}
      <button class="dylemat__sound" type="button" data-sound aria-pressed="false" hidden>Dźwięk: wyłączony</button>
      {%- endif %}
    </div>
    {%- if dylemat.audio.intro %}
    <audio data-audio-intro src="{{ dylemat.audio.intro }}" preload="none"></audio>
    {%- endif %}
    {%- if dylemat.audio.ambient %}
    <audio data-audio-ambient src="{{ dylemat.audio.ambient }}" loop preload="none"></audio>
    {%- endif %}
    <script type="application/json" id="dylemat-data">{{ dylemat | dump | safe }}</script>
  </body>
</html>
